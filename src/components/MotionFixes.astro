---
/** Site-side workaround for @pcl/design-system v0.3.0, included once per page.
 *  `reveal--wipe` and `reveal--mask` start fully clipped (clip-path: inset(100% …)). Chromium
 *  computes IntersectionObserver ratios after clip-path, so the shared observer's 0.08
 *  threshold never fires for them: they only appeared through the 2.5 s safety net (first
 *  viewport) and never when scrolled into view later. Observe them here with threshold 0,
 *  which fires as soon as the element's edge enters the viewport. Remove once fixed upstream. */
---
<script>
  const mq = window.matchMedia('(prefers-reduced-motion: no-preference)');
  const els = document.querySelectorAll<HTMLElement>('.reveal--wipe, .reveal--mask');
  if (els.length && mq.matches && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) if (en.isIntersecting) { en.target.classList.add('is-visible'); io.unobserve(en.target); }
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0 });
    els.forEach((e) => io.observe(e));
  }
</script>
