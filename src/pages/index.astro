---
import { Layout, Section, Button, SectionMark, Figure } from '@pcl/design-system';
import { getEntry, render } from 'astro:content';
import { pdfs, citation } from '../site.config';
import { siteConfig as site, u, navFor } from '../lib/url';
import Citation from '../components/Citation.astro';
import FooterCredit from '../components/FooterCredit.astro';
import MotionFixes from '../components/MotionFixes.astro';
import '../styles/site.css';

const entry = await getEntry('docs', 'home');
const { Content } = await render(entry!);
const nav = navFor('/');

const words: { initial: string; rest: string; key: string }[] = [
  { initial: 'Re', rest: 'porting', key: 're' },
  { initial: 'S', rest: 'etting in', key: 's' },
  { initial: 'P', rest: 'sychedelic', key: 'p' },
  { initial: 'C', rest: 'linical', key: 'c' },
  { initial: 'T', rest: 'rials', key: 't' },
];
// Depth planes of the cover (see the markup). Speeds are relative to the page: negative = slower
// than the page (further away), positive = slightly faster (nearer). Max = px clamp per plane.
const layers = [
  { name: 'bg', speed: '-0.09', max: '110' },
  { name: 'central', speed: '-0.05', max: '60' },
  { name: 'right', speed: '-0.02', max: '30' },
  { name: 'front', speed: '0.02', max: '30' },
];
const BLANK = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
const illustrationAlt =
  'Watercolour illustration of psilocybin mushrooms; inside the cap of the largest one, two people recline in a warmly lit room with speakers and cushions.';
const detailAlt =
  'Detail of the ReSPCT illustration: inside a mushroom cap, two people recline in a warmly lit room with speakers, cushions and plants.';

const schema = [
  site.organizationSchema!,
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    alternateName: 'ReSPCT',
    url: site.url,
    publisher: { '@type': 'Organization', name: site.name },
    about: {
      '@type': 'ScholarlyArticle',
      headline: citation.title,
      identifier: `https://doi.org/${citation.doi}`,
      url: citation.url,
      isPartOf: { '@type': 'Periodical', name: citation.journal },
      datePublished: citation.year,
    },
  },
];
---
<Layout
  site={site}
  page={{
    title: 'The ReSPCT Guidelines — Reporting of Setting in Psychedelic Clinical Trials',
    description: entry!.data.description,
    path: '/',
    schema,
    bodyClass: 'home',
  }}
  nav={nav}
>
  <main id="main">
    <!-- Full-width cover: the square illustration shown whole, fading into the paper
         at the top and bottom; the acrostic title sits on the paper at the top left. -->
    <div class="cover">
      <!-- The stage holds the illustration and, on wide screens, the title layer that sits on
           top of it. The title is position: sticky inside the stage: it stays exactly where it
           is on screen while the illustration scrolls up beneath it (the paper gradient behind
           it travels with it), and it is carried away only when it reaches the bottom of the
           illustration. Pure CSS, compositor-only, no per-frame script. -->
      <div class="cover__stage">
        <div class="container cover__title">
          <div class="cover__title-layer">
            <div class="cover__fade-left" aria-hidden="true"></div>
            <h1 class="acrostic reveal reveal--wipe" style="--reveal-dur: 1100ms" aria-label="Reporting Setting in Psychedelic Clinical Trials">
              {words.map((w) => (
                <span class="acrostic__word" aria-hidden="true">
                  <span class={`acrostic__initial acrostic__initial--${w.key}`}>{w.initial}</span>{w.rest}
                </span>
              ))}
            </h1>
          </div>
        </div>
        <div class="cover__frame">
          <!-- Narrow screens / reduced motion: the flat illustration. Wide screens: the same picture
               cut into four depth planes (paper + grass, the tall mushroom, the right one, the group in
               front with the ground) that scroll at slightly different speeds. The <picture> sources
               swap in a 1-px placeholder so each screen only downloads the version it shows. -->
          <picture class="cover__flat">
            <source media="(min-width: 60em) and (prefers-reduced-motion: no-preference)" srcset={BLANK} />
            <img
              class="cover__img"
              src={u('/images/respct-illustration-1600.webp')}
              srcset={`${u('/images/respct-illustration-800.webp')} 800w, ${u('/images/respct-illustration-1600.webp')} 1600w`}
              sizes="min(100vw, 1100px)"
              width="2480"
              height="2481"
              alt={illustrationAlt}
              fetchpriority="high"
              decoding="async"
            />
          </picture>
          <div class="cover__layers" role="img" aria-label={illustrationAlt}>
            {layers.map((l) => (
              <picture class={`cover__layer cover__layer--${l.name}`}>
                <source media="(max-width: 59.99em), (prefers-reduced-motion: reduce)" srcset={BLANK} />
                <img src={u(`/images/respct-cover-${l.name}.webp`)} width="1600" height="1600" alt="" decoding="async"
                  fetchpriority="high"
                  data-parallax={l.speed} data-parallax-max={l.max} />
              </picture>
            ))}
          </div>
          <script>
            // The four planes appear together, once all of them are decoded (otherwise a heavy plane can
            // show up alone for a moment on first load).
            const box = document.querySelector<HTMLElement>('.cover__layers');
            const imgs = [...document.querySelectorAll<HTMLImageElement>('.cover__layer img')];
            const show = () => box?.classList.add('is-ready');
            Promise.all(imgs.map((i) => (i.complete ? Promise.resolve() : i.decode().catch(() => {})))).then(show);
            setTimeout(show, 2500);
          </script>
        </div>
      </div>
      <div class="container">
        <p class="cover__credit reveal reveal--fade">
          Illustration by <a href="https://natashawigoder.com/" target="_blank" rel="noopener noreferrer">Natasha Wigoder</a>.
        </p>
      </div>
    </div>

    <!-- Reveal treatments on this page: headings wipe, the intro blurs in, the figure is
         unmasked from the bottom, the pull quote rises further, the grid staggers slowly. -->
    <Section tight>
      <SectionMark label="An international Delphi consensus" accent />
      <div class="container--reading home-intro stack">
        <div class="prose prose--centered reveal reveal--blur" style="--reveal-dur: 1000ms"><Content /></div>
        <Citation class="reveal reveal--fade" />
        <div class="cluster home-intro__actions reveal" style="--reveal-delay: 120ms; --reveal-dur: 900ms">
          <Button href={u('/the-respct-guidelines/')}>The ReSPCT Guidelines</Button>
          <Button href={u('/the-explanatory-document/')} variant="secondary">Explanatory Document</Button>
          <Button href={citation.url} variant="secondary" external>Original Article</Button>
        </div>
      </div>
    </Section>

    <Section band>
      <div class="image-pair home-pair">
        <Figure
          class="reveal reveal--mask"
          src={u('/images/respct-illustration-detail-800.webp')}
          srcset={`${u('/images/respct-illustration-detail-800.webp')} 800w, ${u('/images/respct-illustration-detail-1600.webp')} 1600w`}
          sizes="(min-width: 40em) 50vw, 100vw"
          width={1600}
          height={2126}
          alt={detailAlt}
          ratio="tall"
          drift
          caption="The dosing room, inside the cap. Illustration by Natasha Wigoder."
        />
        <blockquote class="pullquote reveal reveal--rise-lg" style="--reveal-delay: 160ms">
          We encourage study teams to report each item in publications of clinical trials involving psychedelic drugs, either in the main article or as supplementary information.
          <cite><a href={u('/the-explanatory-document/')}>The ReSPCT Guidelines Explained</a>, introduction</cite>
        </blockquote>
      </div>
    </Section>

    <Section tight ariaLabelledby="downloads" watermark="veins" watermarkPosition="right" watermarkInk>
      <SectionMark label="Resources" />
      <h2 id="downloads" class="reveal reveal--wipe home-downloads__title" style="--reveal-dur: 900ms">Downloads</h2>
      <div class="grid grid--2 reveal-group reveal-group--slow home-downloads" style="margin-top: var(--s-8)">
        <div class="card card--lift">
          <p class="eyebrow">PDF</p>
          <h3>Explanatory document</h3>
          <p>Each of the 30 items explained, with suggested reporting questions, measurement tools and expert quotes from the Delphi process.</p>
          <p><Button href={u(pdfs.explanatory)} variant="primary" size="small">Download the explanatory document</Button></p>
        </div>
        <div class="card card--lift">
          <p class="eyebrow">PDF</p>
          <h3>Printable checklist</h3>
          <p>A fillable, printable checklist of the 30 ReSPCT items to complete and submit alongside a psychedelic clinical trial publication.</p>
          <p><Button href={u(pdfs.checklist)} variant="primary" size="small">Download the printable checklist</Button></p>
        </div>
      </div>
    </Section>
  </main>
  <FooterCredit slot="footer-meta" />
  <MotionFixes />
</Layout>

